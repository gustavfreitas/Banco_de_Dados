CREATE TABLE LIVRO
(
ISBN INT,
TITULO VARCHAR(50) NOT NULL,
EDICAO VARCHAR(50) NOT NULL,
DATAPUB DATE,
CONSTRAINT pk_ISBN28 PRIMARY KEY (ISBN)
)

CREATE TABLE AUTOR(
IDAUT INT,
NOME VARCHAR(50) NOT NULL,
CONSTRAINT pk_IDAUT28 PRIMARY KEY(IDAUT)
)

CREATE TABLE LIVROAUTOR(
ISBN INT NOT NULL,
IDAUT INT NOT NULL,
CONSTRAINT fk_ISBN FOREIGN KEY (ISBN) REFERENCES LIVRO28(ISBN),
CONSTRAINT fk_IDAUT FOREIGN KEY (IDAUT) REFERENCES AUTOR28(IDAUT)
)
